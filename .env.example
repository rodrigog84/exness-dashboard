# Exness Trader API (server-side only — never NEXT_PUBLIC_*)
EXN_API_KEY=exnsk-your_public_api_key
EXN_PRIVATE_KEY=paste_128_hex_chars_or_PEM_private_key
EXN_ACCOUNT_ID=123456789
EXN_DISCOVERY_BASE_URL=https://api.exness.com

# Safety — demo only by default; live refused without EXNESS_ALLOW_LIVE=yes
EXNESS_ENV=demo
# EXNESS_ALLOW_LIVE=yes

# Dashboard gate (shared password — cookie + optional header)
DASHBOARD_SECRET=change-me-to-a-long-random-string

# Optional trading / robot defaults
EXNESS_INSTRUMENT=BTCUSD
EXNESS_SIDE=buy
EXNESS_VOLUME=0.01
EXNESS_ENTRY_MODE=alternate
EXNESS_HOLD_TICKS=10
EXNESS_SL_PCT=0.3
# EXNESS_SL_USD=5
# EXNESS_TP_PCT=0.5
# EXNESS_TP_USD=8
EXNESS_POLL_TIMEOUT_SEC=60

# Vercel Cron (auto-set on Vercel; set locally only if calling /api/cron/tick)
# CRON_SECRET=
